NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=<add-service-role-key-for-admin-routes>

# Prelaunch gate — ISO8601 UTC.
# If now < PRELAUNCH_DATETIME: show countdown/prelaunch page at /.
# If now >= PRELAUNCH_DATETIME: redirect unauthenticated users to /login.
# Remove or leave empty to skip prelaunch gate (go straight to login/homepage).
PRELAUNCH_DATETIME=2026-12-31T00:00:00.000Z

# Launch / event-start datetime — ISO8601 UTC. Public (available client-side).
# Used for the homepage event-start countdown timer.
# Independent of PRELAUNCH_DATETIME.
NEXT_PUBLIC_LAUNCH_DATETIME=2026-12-31T00:00:00.000Z
